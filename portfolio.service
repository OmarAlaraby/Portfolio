[Unit]
Description=Portfolio Django Application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/path/to/your/portfolio
ExecStart=/path/to/your/portfolio/.venv/bin/gunicorn -c /path/to/your/portfolio/gunicorn_config.py portfolio.wsgi:application
Restart=on-failure
RestartSec=5
Environment=DJANGO_SETTINGS_MODULE=portfolio.settings_prod

[Install]
WantedBy=multi-user.target 